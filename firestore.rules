rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test collection for initial connectivity validation
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile: only owner can read and write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User financial records: only owner can access
    match /users/{userId}/finance/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
